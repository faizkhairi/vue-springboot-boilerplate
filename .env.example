# Backend (export these, or place them in backend/.env if you load env files yourself)
DATABASE_URL=jdbc:postgresql://localhost:5432/vue_springboot
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Required, no default. Must be at least 32 bytes (256 bits) for HS256; the app
# fails fast at startup if it is missing or too short. Generate one with:
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-32-byte-secret-at-least-256-bits
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
APP_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
# Number of trusted reverse-proxy hops in front of the API; used to pick the
# real client IP out of X-Forwarded-For for auth rate limiting. Default: 1.
# Use 0 when the API is exposed directly (forwarding headers are then ignored).
TRUSTED_PROXY_COUNT=1

# Frontend (frontend/.env)
# Optional. Empty means relative /api, which the Vite dev and preview servers
# proxy to http://localhost:8080. Set this only when the frontend calls the
# API at a different origin (for example, the Docker Compose full stack).
VITE_API_BASE_URL=
