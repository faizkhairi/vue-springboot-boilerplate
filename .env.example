# Backend (or set in environment)
DATABASE_URL=jdbc:postgresql://localhost:5432/vue_springboot
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Required, no default. Must be at least 32 bytes (256 bits) for HS256.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-32-byte-secret-at-least-256-bits
SMTP_HOST=localhost
SMTP_PORT=1025

# Frontend (frontend/.env)
# VITE_API_BASE_URL=http://localhost:8080
